# Environment Configuration Template for Docker Swarm Infrastructure
# Copy this file to .env and fill in your actual values
# This file contains all required environment variables with examples and documentation

# =============================================================================
# COMMON CONFIGURATION
# =============================================================================

# Container Timezone
# Purpose: Timezone passed as TZ to all containers in the infra, monitoring, and portainer stacks
# Format: IANA timezone identifier
# Default: UTC
# Example: Europe/Berlin
TIMEZONE=UTC

# Root Domain
# Purpose: Base domain used to build Traefik route hosts for exposed services
#          (redis., pma., admin., prometheus., alerts., mon.)
# Format: Domain name without scheme or trailing slash
# Example: example.com
# Example: mycompany.dev
ROOT_DOMAIN=example.com

# Stack Version
# Purpose: Version suffix for Docker config names (e.g. traefik.yml_0, prometheus.yml_0)
#          Increment to force config redeployment on config-only updates
# Format: Integer
# Default: 0
STACK_VERSION=0

# =============================================================================
# INFRA CONFIGURATION
# =============================================================================

# Database Backup AWS Region
# Purpose: AWS region of the S3 bucket used by the db-backup service (mariadb-backup-s3)
# Format: AWS region code
# Example: us-east-1
DB_BACKUP__AWS_REGION=us-east-1

# Database Backup AWS Access Key ID
# Purpose: AWS access key with write access to the backup bucket
# Format: AWS access key ID (20 characters)
# Example: your-access-key
DB_BACKUP__AWS_ACCESS_KEY_ID=<your-access-key>

# Database Backup AWS Secret Access Key
# Purpose: Secret key paired with DB_BACKUP__AWS_ACCESS_KEY_ID for S3 authentication
# Format: AWS secret access key
# Example: your-secret-key
DB_BACKUP__AWS_SECRET_ACCESS_KEY=<your-secret-key>

# Database Backup User Password
# Purpose: Password of the dedicated 'backup' MariaDB user used to dump the database
# Format: Plain text password
# Example: your-password
DB_BACKUP__PASSWORD=<database-backup-user-password>

# Database Backup Options
# Purpose: Extra options passed to mysqldump during backup (e.g. --single-transaction)
# Format: Space-separated mysqldump flags (empty disables extras)
# Default: (empty)
DB_BACKUP__OPTIONS=

# Database Backup Storage URL
# Purpose: S3 URI where backups are uploaded by the db-backup service
# Format: s3://bucket-name[/path]
# Example: s3://my-bucket/backups
DB_BACKUP__STORAGE_URL=s3://bucket-name/backups

# Database Backup Schedule
# Purpose: Cron expression for swarm-cronjob that triggers the db-backup service
# Format: Cron expression (enclose in single quotes)
# Default: '@daily'
# Example: '@daily'
# Example: '0 2 * * *'
DB_BACKUP__SCHEDULE='@daily'

# Database Admin Basic Auth
# Purpose: htpasswd entry protecting the phpMyAdmin UI route (pma.<ROOT_DOMAIN>)
# Format: htpasswd user:hash ($$ escapes $ for compose interpolation)
# Example: admin:$$apr1$$hashed$$password
DB_ADMIN_AUTH=admin:$$apr1$$hashed$$password

# Traefik Dashboard Basic Auth
# Purpose: htpasswd entry protecting the Traefik dashboard route (admin.<ROOT_DOMAIN>)
# Format: htpasswd user:hash ($$ escapes $ for compose interpolation)
# Example: admin:$$apr1$$hashed$$password
DASHBOARD_AUTH=admin:$$apr1$$hashed$$password

# Traefik Metrics IP Whitelist
# Purpose: Comma-separated IP ranges allowed to reach Traefik metrics endpoints
#          (expanded into the monitoring-metrics-ip-whitelist middleware)
# Format: Comma-separated CIDR list
# Example: 127.0.0.1,192.168.0.0/16
TRAEFIK__METRICS_IP_WHITELIST=127.0.0.1,192.168.0.0/16

# =============================================================================
# APP STACK CONFIGURATION
# =============================================================================

# HTTP Proxy Header
# Purpose: Header trusted by application stacks deployed on top of this infrastructure
#          when running behind Traefik (not consumed by this repository's compose files)
# Format: HTTP header name
# Example: X-Forwarded-For
HTTP__PROXY_HEADER=X-Forwarded-For

# HTTP Proxies
# Purpose: CIDR ranges of proxies that applications should trust for HTTP__PROXY_HEADER
#          (convention for application stacks deployed on top of this infrastructure)
# Format: Comma-separated CIDR list
# Example: 10.0.0.0/16
HTTP__PROXIES=10.0.0.0/16

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Prometheus IP Allowlist
# Purpose: IP ranges allowed to access the Prometheus UI route (prometheus.<ROOT_DOMAIN>)
# Format: Comma-separated CIDR list
# Default: 127.0.0.1/32
# Example: 127.0.0.1,192.168.0.0/16
PROMETHEUS__IP_ALLOWLIST=127.0.0.1,192.168.0.0/16

# Alertmanager IP Allowlist
# Purpose: IP ranges allowed to access the Alertmanager UI route (alerts.<ROOT_DOMAIN>)
# Format: Comma-separated CIDR list
# Default: 127.0.0.1/32
# Example: 127.0.0.1,192.168.0.0/16
ALERTMANAGER__IP_ALLOWLIST=127.0.0.1,192.168.0.0/16
