---
# Copy this file to all.yml before running the playbook.
# all.yml is ignored by git.

# Swap file created before any package install so dnf does not get OOM-killed
# on low-memory nodes (rc 137 / "No start of json char found"). Set
# swap_manage: false per host to opt out; changing swap_file_size does not
# resize an existing file.
swap_manage: true
swap_file_size: 2G
swap_swappiness: 10

# Remove packages that conflict with Docker CE on a fresh RHEL-family node.
# This is destructive: keep the package list explicit and review it first.
docker_engine_remove_conflicts: true
docker_engine_conflict_packages:
  - docker
  - docker-client
  - docker-client-latest
  - docker-common
  - docker-latest
  - docker-latest-logrotate
  - docker-logrotate
  - docker-engine
  - podman
  - podman-docker
  - buildah
  - runc

# Existing Swarm manager address (host only, without :2377). Use the manager's
# private-network address. Required for swarm_role: join_manager and
# swarm_role: join_worker.
swarm_manager_addr: 203.0.113.10

# Address advertised by the new node. Defaults to the primary IPv4 address.
# On dual-network hosts set this to the node's private-network address so Swarm
# traffic stays off the public interface.
swarm_advertise_addr: "{{ ansible_default_ipv4.address | default(ansible_host) }}"

# Existing manager used to apply labels to joined workers. The manager must be
# present in the inventory. Not needed when the new node is a manager.
swarm_label_delegate: node1

# Configure firewalld only when it is active. Set to false if the firewall is
# managed outside this playbook. When true, firewalld is installed, started,
# and kept enabled.
firewall_manage: true

# Private-network interface on each Swarm node (multi-node clusters). Swarm
# ports are opened only in firewalld's internal zone on this interface;
# published ports remain in the public zone. Leave empty for single-node
# clusters: Swarm traffic then stays on loopback and no Swarm port is opened
# on any interface. Override per host in inventory if interface names differ.
firewall_swarm_interface: ""

# SSH hardening block at the top of /etc/ssh/sshd_config (wins over every
# drop-in, including RHEL's stock 50-redhat.conf). Inventory authenticates
# with a key, so password authentication is disabled by default. Set
# ssh_hardening_password_authentication: true on any host that still needs
# password logins. Root login is prohibited entirely
# (ssh_hardening_permit_root_login: "no"), so inventory must use a regular
# user with sudo; override per host only if root access is required.
ssh_hardening_manage: true

# SSH brute-force protection with fail2ban. fail2ban ships in EPEL; the
# playbook downloads the EPEL release package from Fedora when fail2ban is not
# installed yet (set fail2ban_install_epel: false to use a mirror you trust).
fail2ban_install_epel: true

# Sources exempt from banning. Add your control-node, VPN, or office addresses
# so administrative SSH sessions cannot lock themselves out.
fail2ban_ignoreip: "127.0.0.1/8 ::1"

# Thresholds for the sshd jail.
fail2ban_bantime: 10m
fail2ban_findtime: 10m
fail2ban_maxretry: 5

# Deploy or update the Portainer stack from the first manager in the inventory.
# Set true only after restricting access to Portainer's 9443/tcp endpoint; the
# first-install administrator setup on a fresh deployment is unauthenticated.
portainer_deploy: false
